<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cloth Shopping Store</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 0; background-color: #f4f4f4; }
        header { background-color: #333; color: white; padding: 15px; text-align: center; }
        nav { display: flex; justify-content: center; background: #444; padding: 10px; }
        nav a { color: white; margin: 0 15px; text-align: center; text-decoration: none; }
        .container { display: flex; flex-wrap: wrap; justify-content: center; padding: 20px; }
        .product-card { background: white; margin: 15px; padding: 15px; border-radius: 8px; width: 250px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); text-align: center; }
        .product-card img { max-width: 100%; height: auto; border-radius: 4px; }
        .price { color: #e44d26; font-size: 18px; font-weight: bold; margin: 10px 0; }
        .buy-btn { background-color: #e44d26; color: white; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer; width: 100%; }
        footer { background-color: #333; color: white; text-align: center; padding: 10px; position: fixed; bottom: 0; width: 100%; }
    </style>
</head>
<body>

<header>
    <h1>Welcome to My Cloth Shopping Store</h1>
</header>

<nav>
    <a href="#">Home</a>
    <a href="#">Mens</a>
    <a href="#">Womens</a>
    <a href="#">Contact Us</a>
</nav>

<div class="container">
    <!-- Product 1 -->
    <div class="product-card">
        <h3>Stylish T-Shirt</h3>
        <p class="price">₹499</p>
        <button class="buy-btn">Add to Cart</button>
    </div>

    <!-- Product 2 -->
    <div class="product-card">
        <h3>Casual Jeans</h3>
        <p class="price">₹999</p>
        <button class="buy-btn">Add to Cart</button>
    </div>
</div>

</body>
</html>
